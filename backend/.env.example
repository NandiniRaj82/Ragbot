# Copy this file to .env and fill in your values before running the backend.

# Required: Your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Path where ChromaDB will persist its data (default: ./chroma_db)
CHROMA_DB_PATH=./chroma_db

# Optional: URL of your frontend (used for CORS allow-list)
FRONTEND_URL=http://localhost:3000

# Optional: Maximum video duration in seconds (default: 1800 = 30 minutes)
MAX_VIDEO_DURATION_SECONDS=1800
